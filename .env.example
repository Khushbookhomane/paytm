# ============================================================
# Paytm VentureAI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- App ---
APP_ENV=development          # development | production
PROJECT_NAME=Paytm VentureAI
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MERCHANT_TIMEZONE=Asia/Kolkata

# --- Database ---
# SQLite (local development)
DATABASE_URL=sqlite:///./venture_ai.db
# PostgreSQL (production)
# DATABASE_URL=postgresql://user:password@localhost:5432/ventureai

# --- Security & JWT ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=paytm-venture-ai-hackathon-secret-key-change-in-prod
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Field-level encryption key for sensitive bank account numbers (Fernet 32-byte urlsafe base64)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- WebAuthn / Passkeys ---
RP_ID=localhost
RP_NAME=Paytm VentureAI
RP_ORIGIN=http://localhost:3000

# --- Google OAuth 2.0 / OpenID Connect ---
# Register at https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=<your-google-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<your-google-client-secret>
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# --- Passwordless Email Magic Links ---
# console = print token link directly to server logs (development only)
# ses     = Amazon Simple Email Service (requires boto3 + AWS credentials)
# resend  = Resend.com (requires RESEND_API_KEY)
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=noreply@ventureai.in

# --- Cashfree Bank Account Ownership Verification ---
# Penny-drop verification sandbox/production: https://www.cashfree.com
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENVIRONMENT=sandbox   # sandbox | production
CASHFREE_WEBHOOK_SECRET=

# --- Account Aggregator (AA) Integration ---
# Under RBI Master Directions, live financial queries require FIU registration
ACCOUNT_AGGREGATOR_PROVIDER=setu   # setu | finvu
AA_CLIENT_ID=
AA_CLIENT_SECRET=
AA_ENVIRONMENT=sandbox             # sandbox | production
AA_WEBHOOK_SECRET=

# --- Paytm Merchant Integration ---
# Requires official Paytm Partner / Merchant onboarding
PAYTM_API_BASE_URL=https://securegw-stage.paytm.in
PAYTM_CLIENT_ID=
PAYTM_CLIENT_SECRET=
PAYTM_MERCHANT_ID=
PAYTM_WEBHOOK_SECRET=

# --- AI / LLM Intelligence ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-3-5-sonnet-20241022

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api
